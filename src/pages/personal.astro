---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const personal = await getCollection('personal');
const jefe = personal.filter((p) => p.data.grupo === 'responsable');
const matutino = personal.filter((p) => p.data.grupo === 'tecnicos' && !p.data.rol.includes('Vespertino'));
const vespertino = personal.filter((p) => p.data.grupo === 'tecnicos' && p.data.rol.includes('Vespertino'));
const profesores = personal.filter((p) => p.data.grupo === 'profesores');
---
<Base title="Personal Docente y Técnico | Laboratorio de Análisis Industriales y Especiales" active="/personal">
  <section class="page-hero"><div class="container reveal">
    <p class="crumbs"><a href="/">Inicio</a> / Personal</p>
    <p class="eyebrow">Equipo</p>
    <h1>Personal del laboratorio</h1>
    <p>Jefatura, responsables por turno y profesores. Contenido editable desde el CMS (colección “Personal”).</p>
  </div></section>

  <section class="section"><div class="container">
    <div class="section-head reveal"><p class="eyebrow">Jefatura</p><h2>Responsable de Laboratorio</h2></div>
    {Jefe.map((p) => (
      <article class="leader reveal">
        {p.data.foto ? (
          <img class="avatar avatar-img" src={p.data.foto} alt={`Foto de ${p.data.nombre}`} loading="lazy" decoding="async" />
        ) : (
          <div class="avatar">{p.data.iniciales || p.data.nombre.slice(0, 2).toUpperCase()}</div>
        )}
        <div>
          <h3>{p.data.nombre}</h3>
          <p class="role">{p.data.rol}</p>
          <p class="bio">{p.data.bio}</p>
          {p.data.email && <p><a class="mail" href={`mailto:${p.data.email}`}>{p.data.email}</a></p>}
        </div>
      </article>
    ))}
  </div></section>

  <section class="section section-alt"><div class="container">
    <div class="section-head reveal"><p class="eyebrow">Turno matutino</p><h2>Responsables matutino</h2></div>
    <div class="people-grid reveal">
      {matutino.map((p) => (
        <article class="person">
          {p.data.foto ? (
            <img class="avatar avatar-img" src={p.data.foto} alt={`Foto de ${p.data.nombre}`} loading="lazy" decoding="async" />
          ) : (
            <div class="avatar">{p.data.iniciales || p.data.nombre.slice(0, 2).toUpperCase()}</div>
          )}
          <h3>{p.data.nombre}</h3>
          <p class="role">{p.data.rol}</p>
          <p class="bio">{p.data.bio}</p>
          {p.data.email && <p><a class="mail" href={`mailto:${p.data.email}`}>{p.data.email}</a></p>}
        </article>
      ))}
    </div>
  </div></section>

  <section class="section"><div class="container">
    <div class="section-head reveal"><p class="eyebrow">Turno vespertino</p><h2>Responsable vespertino</h2></div>
    <div class="people-grid reveal">
      {vespertino.map((p) => (
        <article class="person">
          {p.data.foto ? (
            <img class="avatar avatar-img" src={p.data.foto} alt={`Foto de ${p.data.nombre}`} loading="lazy" decoding="async" />
          ) : (
            <div class="avatar">{p.data.iniciales || p.data.nombre.slice(0, 2).toUpperCase()}</div>
          )}
          <h3>{p.data.nombre}</h3>
          <p class="role">{p.data.rol}</p>
          <p class="bio">{p.data.bio}</p>
          {p.data.email && <p><a class="mail" href={`mailto:${p.data.email}`}>{p.data.email}</a></p>}
        </article>
      ))}
    </div>
  </div></section>

  {profesores.length > 0 && (
    <section class="section section-alt"><div class="container">
      <div class="section-head reveal"><p class="eyebrow">Profesores / Instructores</p><h2>Quienes imparten asignaturas</h2></div>
      <div class="people-grid reveal">
        {profesores.map((p) => (
          <article class="person">
            {p.data.foto ? (
              <img class="avatar avatar-img" src={p.data.foto} alt={`Foto de ${p.data.nombre}`} loading="lazy" decoding="async" />
            ) : (
              <div class="avatar">{p.data.iniciales || p.data.nombre.slice(0, 2).toUpperCase()}</div>
            )}
            <h3>{p.data.nombre}</h3>
            <p class="role">{p.data.rol}</p>
            <p class="bio">{p.data.bio}</p>
            {p.data.email && <p><a class="mail" href={`mailto:${p.data.email}`}>{p.data.email}</a></p>}
          </article>
        ))}
      </div>
    </div></section>
  )}
</Base>
