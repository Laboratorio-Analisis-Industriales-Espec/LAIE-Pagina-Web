---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const horario = await getCollection('horario');
const csv = horario[0]?.data.csv || '';

function parseCSV(line: string) {
  const cells: string[] = [];
  let current = '';
  let inQuotes = false;
  for (let i = 0; i < line.length; i++) {
    const char = line[i];
    if (char === '"' && line[i + 1] === '"') {
      current += '"';
      i++;
      continue;
    }
    if (char === '"') {
      inQuotes = !inQuotes;
      continue;
    }
    if (char === ',' && !inQuotes) {
      cells.push(current);
      current = '';
      continue;
    }
    current += char;
  }
  cells.push(current);
  return cells.map((c) => c.trim());
}

function parseHorario(csvText: string) {
  if (!csvText) return { header: [] as string[], rows1: [] as string[][], rows2: [] as string[][] };

  const lines = csvText
    .split(/\r?\n/)
    .map((l) => l.replace(/\r$/, ''))
    .filter((l) => l.trim().length > 0);

  const parsed = lines.map((line) => parseCSV(line));

  let headerRowIndex = -1;
  for (let i = 0; i < parsed.length; i++) {
    const row = parsed[i];
    if (
      row.some((c) => {
        const u = c.toUpperCase();
        return u.includes('LUNES') || u.includes('MARTES') || u.includes('MIÉRCOLES') || u.includes('JUEVES') || u.includes('VIERNES') || u.includes('SABADO') || u.includes('SÁBADO');
      })
    ) {
      headerRowIndex = i;
      break;
    }
  }

  const header = headerRowIndex >= 0 ? parsed[headerRowIndex] : [];
  const rows1: string[][] = [];
  const rows2: string[][] = [];

  for (let i = headerRowIndex + 1; i < parsed.length; i++) {
    const row = parsed[i];
    if (row.length === 0) continue;

    const espacioCell = row.find((c) => c.toUpperCase().includes('ESPACIO'));
    if (espacioCell) {
      const u = espacioCell.toUpperCase();
      if (u.includes('ESPACIO 1')) {
        rows1.push(row);
        continue;
      }
      if (u.includes('ESPACIO 2')) {
        rows2.push(row);
        continue;
      }
      if (u.includes('ESPACIO 3')) {
        rows1.push(row);
        continue;
      }
    }

    const hasLab = row.some((c) => c.toUpperCase().includes('LABORATORIO'));
    const hasSubject = row.some((c) => /\([^)]+\)/.test(c));
    if (hasLab || hasSubject) {
      if (rows1.length <= rows2.length) {
        rows1.push(row);
      } else {
        rows2.push(row);
      }
    }
  }

  return { header, rows1, rows2 };
}

const { header, rows1, rows2 } = parseHorario(csv);
---

<Base title="Horario | Laboratorio de Análisis Industriales y Especiales" active="/horario">
  <section class="page-hero">
    <div class="container reveal">
      <p class="crumbs"><a href="/">Inicio</a> / Horario</p>
      <p class="eyebrow">Horarios</p>
      <h1>Horario del Laboratorio</h1>
      <p>Horario de prácticas por espacio. Editable desde el CMS.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {csv ? (
        <div class="schedule-wrap">
          <div class="schedule-tabs" role="tablist" aria-label="Horarios por espacio">
            <button class="schedule-tab active" data-tab="espacio1" role="tab" aria-selected="true">Espacio 1</button>
            <button class="schedule-tab" data-tab="espacio2" role="tab" aria-selected="false">Espacio 2</button>
          </div>

          <div class="schedule-panel active" data-panel="espacio1" role="tabpanel">
            <div class="table-wrap schedule-table-wrap">
              <table class="data schedule-table">
                <thead>
                  <tr>
                    {header.map((h) => (
                      <th>{h}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {rows1.map((row) => (
                    <tr>
                      {row.map((cell) => (
                        <td class={cell.toUpperCase().includes('LABORATORIO S/ SERVICIO') ? 'servicio' : ''}>{cell}</td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

          <div class="schedule-panel" data-panel="espacio2" role="tabpanel">
            <div class="table-wrap schedule-table-wrap">
              <table class="data schedule-table">
                <thead>
                  <tr>
                    {header.map((h) => (
                      <th>{h}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {rows2.map((row) => (
                    <tr>
                      {row.map((cell) => (
                        <td class={cell.toUpperCase().includes('LABORATORIO S/ SERVICIO') ? 'servicio' : ''}>{cell}</td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      ) : (
        <div class="notice">
          <h3>Sin horario configurado</h3>
          <p>Agrega el CSV en Keystatic → Horario del laboratorio</p>
        </div>
      )}
    </div>
  </section>

  <script>
    const tabs = document.querySelectorAll('.schedule-tab');
    const panels = document.querySelectorAll('.schedule-panel');
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-tab');
        tabs.forEach((t) => {
          t.classList.toggle('active', t === tab);
          t.setAttribute('aria-selected', t === tab ? 'true' : 'false');
        });
        panels.forEach((p) => {
          p.classList.toggle('active', p.getAttribute('data-panel') === target);
        });
      });
    });
  </script>
</Base>
