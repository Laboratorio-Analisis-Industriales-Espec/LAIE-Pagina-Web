---
import Logo from '../components/Logo.astro';

interface Props {
  title: string;
  description?: string;
  active?: string;
}
const { title, description = 'Laboratorio de Análisis Industriales y Especiales.', active = '/' } = Astro.props;
const nav = [
  { href: '/', label: 'Inicio', key: '/' },
  { href: '/cursos', label: 'Cursos', key: '/cursos' },
  { href: '/proyectos', label: 'Proyectos', key: '/proyectos' },
  { href: '/infraestructura', label: 'Infraestructura', key: '/infraestructura' },
  { href: '/personal', label: 'Personal', key: '/personal' },
  { href: '/reglamento', label: 'Reglamento', key: '/reglamento' },
  { href: '/contacto', label: 'Contacto', key: '/contacto' },
];
const year = new Date().getFullYear();
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="stylesheet" href="/styles.css" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header class:list={['site-header', active === '/' ? 'header--home' : 'header--inner']} id="site-header">
      <nav class="nav container" aria-label="Navegación principal">
        <a href="/" class="brand">
          <span class="brand-marks">
            <Logo class="brand-mark brand-mark-dark" />
            <Logo class="brand-mark brand-mark-light" decorative={true} />
          </span>
          <span class="brand-text">Analítica&nbsp;IE</span>
        </a>
        <button class="nav-toggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="nav-menu"><span class="nav-toggle-bar"></span><span class="nav-toggle-bar"></span><span class="nav-toggle-bar"></span></button>
        <ul class="nav-menu" id="nav-menu">
          {nav.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={['nav-link', { active: active === item.key }, { 'nav-cta': item.key === '/contacto' }]}
              >{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-brand-block">
          <Logo class="footer-logo-white" decorative={true} />
          <div class="footer-brand-text">
            <p class="footer-brand">Laboratorio de Análisis<br />Industriales y Especiales</p>
            <p class="footer-tag">Espacio de aprendizaje práctico para la formación de ingenieros. Tercera planta.</p>
          </div>
        </div>
        <nav class="footer-nav" aria-label="Navegación de pie">
          {nav.map((item) => (<a href={item.href}>{item.label}</a>))}
        </nav>
        <p class="copyright">© {year} Laboratorio de Análisis Industriales y Especiales.</p>
      </div>
    </footer>
    <script src="/script.js" defer></script>
  </body>
</html>
